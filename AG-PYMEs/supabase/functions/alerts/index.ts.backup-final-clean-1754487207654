  if (method === "GET" && pathSegments.length === 0) {
    try {
      const { data: alerts, error } = await supabaseAdmin
        .from("alerts")
        .select("*")
        .eq("company_id", authData.company_id)
        .order("fecha_recordatorio", { ascending: false })
        .limit(10);

      if (error) {
        throw error;
      }

      auditLog("ALERTS_LIST", authData, { count: alerts?.length || 0 });
      return createSuccessResponse(alerts || []);
    } catch (error: any) {
      console.error("Error obteniendo alertas:", error);
      return createErrorResponse(
        "Error al obtener alertas",
        500,
        "FETCH_ALERTS_ERROR"
      );
    }
  }

  // POST /alerts - También permitir POST para testing
  if (method === "POST" && pathSegments.length === 0) {
    try {
      const body = await req.json().catch(() => ({}));
      
      // Si no hay body o está vacío, devolver lista de alertas
      if (!body || Object.keys(body).length === 0) {
        const { data: alerts, error } = await supabaseAdmin
          .from("alerts")
          .select("*")
          .eq("company_id", authData.company_id)
          .order("fecha_recordatorio", { ascending: false })
          .limit(10);

        if (error) {
          throw error;
        }

        auditLog("ALERTS_LIST_POST", authData, { count: alerts?.length || 0 });
        return createSuccessResponse({
          message: "Alertas obtenidas correctamente",
          data: alerts || [],
          count: alerts?.length || 0
        });
      }

      // Si hay body, procesar como creación de alerta normal
