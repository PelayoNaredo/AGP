serve(async (req: Request) => {
  // Manejar preflight CORS
  try {
    // 🔒 Autenticación requerida
    const authResult = await requireAuthentication(req);
    if (authResult instanceof Response) {
      return authResult; // Error de autenticación
    }

    const authData = authResult as SecureAuthData;

    // Manejar la request
    return await handleSecureRoute(req, authData);
  } catch (error: any) {
    console.error("🚨 Error en alerts EdgeFunction:", error);
    return createErrorResponse(
      "Error interno del servidor",
      500,
      "INTERNAL_SERVER_ERROR"
    );
  }
});

// Función principal para manejar rutas autenticadas
async function handleSecureRoute(req: Request, authData: SecureAuthData): Promise<Response> {
  const url = new URL(req.url);
